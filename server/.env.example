# Local development environment — used by `npm run dev` and the drizzle-kit db:* scripts.
#
#   cp .env.example .env
#
# For production / Docker, use the .env.example at the repo root instead.

NODE_ENV=development
PORT=4000

# Neon Postgres connection string (Neon dashboard > your project > Connect).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs login sessions. At least 16 characters; generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# Where the Vite dev server runs — the API only accepts cookie-carrying requests from here.
CLIENT_ORIGIN=http://localhost:5173

# Sent in the Scryfall API User-Agent, per their API etiquette guidelines.
SCRYFALL_CONTACT_EMAIL=you@example.com
