# Copy this to `.env` (same directory as docker-compose.yml) and fill in real values.
# `docker compose` reads this file automatically — see docker-compose.yml.

NODE_ENV=production
PORT=4000

# The Neon connection string — same one you use in server/.env for local dev, or a separate
# database if you'd rather keep prod data isolated.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate a real one: `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-string

# Your real domain. Same-origin in this deployment (Express serves the client itself), so
# this mostly just needs to be correct, not load-bearing for CORS the way it is in local dev.
CLIENT_ORIGIN=https://yourdomain.com

SCRYFALL_CONTACT_EMAIL=you@example.com

# From Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > Configure — see DEPLOYMENT.md.
CLOUDFLARE_TUNNEL_TOKEN=
