# Production / Docker environment — used by docker-compose.yml.
#
#   cp .env.example .env
#
# Lives next to docker-compose.yml. `docker compose` loads `.env` automatically: it fills in
# ${CLOUDFLARE_TUNNEL_TOKEN} in the compose file and is passed to the app container as its
# environment. For local development, use server/.env.example instead.
# See DEPLOYMENT.md for the full walkthrough.

# --- App -------------------------------------------------------------------------------------

# Leave these two as-is. The Cloudflare Tunnel hostname points at app:4000, so PORT must
# stay 4000, and production mode is what makes the auth cookie HTTPS-only.
NODE_ENV=production
PORT=4000

# Neon Postgres connection string. Can be the same database you use for local dev, or a
# separate one to keep prod data isolated (a new database needs migrations — see DEPLOYMENT.md).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs login sessions. At least 16 characters; generate one with: openssl rand -base64 48
# Changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string

# The public URL you'll browse to — exactly the tunnel hostname, with https:// and no
# trailing slash (e.g. https://decks.yourdomain.com).
CLIENT_ORIGIN=https://yourdomain.com

# Sent in the Scryfall API User-Agent, per their API etiquette guidelines.
SCRYFALL_CONTACT_EMAIL=you@example.com

# --- Cloudflare Tunnel -----------------------------------------------------------------------

# Just the token string — not the whole `docker run ... --token` command Cloudflare shows.
# Found under Zero Trust > Networks > Tunnels > (your tunnel) > Configure.
CLOUDFLARE_TUNNEL_TOKEN=
